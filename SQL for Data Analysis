import sqlite3

# Connect to database
conn = sqlite3.connect("ecommerce.db")
cur = conn.cursor()

# Create customer table
cur.execute("""
CREATE TABLE IF NOT EXISTS customers(
id INTEGER PRIMARY KEY,
name TEXT,
city TEXT)
""")

# Create orders table
cur.execute("""
CREATE TABLE IF NOT EXISTS orders(
order_id INTEGER PRIMARY KEY,
customer_id INTEGER,
amount REAL,
status TEXT)
""")

# Insert sample data
cur.execute("DELETE FROM customers")
cur.execute("DELETE FROM orders")

cur.executemany(
"INSERT INTO customers VALUES(?,?,?)",
[(1,"Sanjana","Hyderabad"),
 (2,"Rahul","Mumbai"),
 (3,"Priya","Delhi")]
)

cur.executemany(
"INSERT INTO orders VALUES(?,?,?,?)",
[(101,1,5000,"Completed"),
 (102,2,3000,"Completed"),
 (103,1,2000,"Pending"),
 (104,3,4000,"Completed")]
)

conn.commit()

# SELECT query
print("\nCUSTOMER DETAILS")
cur.execute("SELECT * FROM customers")
for row in cur.fetchall():
    print(row)

# WHERE query
print("\nCOMPLETED ORDERS")
cur.execute(
"SELECT * FROM orders WHERE status='Completed'"
)
for row in cur.fetchall():
    print(row)

# ORDER BY query
print("\nORDERS BY AMOUNT")
cur.execute(
"SELECT * FROM orders ORDER BY amount DESC"
)
for row in cur.fetchall():
    print(row)

# GROUP BY query
print("\nTOTAL SALES")
cur.execute("""
SELECT status, SUM(amount)
FROM orders GROUP BY status
""")
for row in cur.fetchall():
    print(row)

# JOIN query
print("\nCUSTOMER ORDER DETAILS")
cur.execute("""
SELECT customers.name, orders.amount
FROM customers
INNER JOIN orders
ON customers.id=orders.customer_id
""")
for row in cur.fetchall():
    print(row)

# Aggregate functions
print("\nAVERAGE ORDER AMOUNT")
cur.execute("SELECT AVG(amount) FROM orders")
print(cur.fetchone())

# Subquery
print("\nORDERS ABOVE AVERAGE")
cur.execute("""
SELECT * FROM orders
WHERE amount > (SELECT AVG(amount) FROM orders)
""")
for row in cur.fetchall():
    print(row)

# Create view
cur.execute("""
CREATE VIEW IF NOT EXISTS sales_view AS
SELECT status, SUM(amount) AS total
FROM orders GROUP BY status
""")

print("\nSALES VIEW")
cur.execute("SELECT * FROM sales_view")
for row in cur.fetchall():
    print(row)

# Create index
cur.execute("""
CREATE INDEX IF NOT EXISTS idx_customer
ON orders(customer_id)
""")

print("\nINDEX CREATED SUCCESSFULLY")
print("TASK 3 COMPLETED SUCCESSFULLY!")

conn.close()